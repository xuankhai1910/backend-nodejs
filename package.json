{
  "name": "nodejs",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc",
    "dev": "tsx watch --inspect src/app.ts",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/app.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.0.1",
    "mysql2": "3.12.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.3",
    "prisma": "6.3.0",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
